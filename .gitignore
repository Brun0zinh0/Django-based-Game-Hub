.venv/
__pycache__/
*.py[cod]
db.sqlite3
.idea/
.vscode/

# Commercial ROM used as an asset source. Not ours to redistribute, and the
# build scripts only need it when regenerating sprites or battlebacks.
*.gba

# Regenerable caches from the asset-fetch scripts.
.rhh-battle-env-cache/
tmp/
*.nds

# Raw artwork downloads. Regenerable with the fetch scripts, and the
# originals are the artists' to distribute, not this repo's.
.battleback-source/
.deviantart-source/
# Anchored to the repo root. Bare "backgrounds/" matches at any depth, and it
# was quietly swallowing games/static/games/assets/terra/backgrounds -- the
# game's own arena art -- so 23 of 33 backdrops would never have been
# committed and the biomes would point at pictures that were not there.
/backgrounds/

# Reference material the Terra Boss art was matched against: someone else's
# screenshot gallery and a clip of the real game. Only these two at the top
# level -- games/static/games/assets/terra/menu-animation.mp4 is built from
# them, is loaded by the menu, and does ship.
/video for background terraria.mp4
/gallery-of-all-my-*.png

# Soundtrack added after the first sync. The tracks are not ours to
# redistribute; the published copy ships sounds/ empty with a README saying
# where to drop your own.
sounds/Pokerogue/
